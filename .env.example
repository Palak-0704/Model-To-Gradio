# Copy to .env (never commit it). All values optional.
# Token used ONLY for huggingface.co requests (gated/private model metadata).
HF_TOKEN=
# Token used ONLY for api.github.com requests (raises the unauthenticated rate limit / avoids 403).
GITHUB_TOKEN=
# Where generated apps/notebooks are written.
# M2G_OUTPUT_DIR=D:\Model To Gradio\output
# DANGEROUS opt-ins, default off:
# M2G_ALLOW_REMOTE_CODE=0
# M2G_ALLOW_PICKLE_WEIGHTS=0
# Google Colab integration through Google's official `colab` CLI (see docs/COLAB_SETUP.md). All optional.
# Full path to colab.exe if it is not on PATH (e.g. after `uv tool install google-colab-cli`):
# COLAB_COMMAND=C:\Users\YOU\.local\bin\colab.exe
# Sign-in mode: oauth2 (default here: the app's 'Sign in with Google' button) or adc (gcloud credentials).
# COLAB_AUTH=oauth2
#
# LEGACY (not used by the Colab panel): the beta, allowlist-only Colab API client in m2g/colab_runtime.py.
M2G_COLAB_API_APPROVED=0
M2G_COLAB_CLIENT_ID=
M2G_COLAB_CLIENT_SECRET=
